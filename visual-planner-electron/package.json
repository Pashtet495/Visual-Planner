{
  "name": "visual-planner",
  "productName": "Visual Planner",
  "version": "0.5.0",
  "description": "Visual Planner - desktop version based on Electron",
  "main": "main.js",
  "author": "Visual Planner",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.visualplanner.app",
    "productName": "Visual Planner",
    "copyright": "Visual Planner",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Visual Planner"
    },
    "portable": {
      "artifactName": "Visual-Planner-Portable-${version}.exe"
    }
  }
}
